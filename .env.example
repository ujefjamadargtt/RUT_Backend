# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rut_portal
DB_USER=postgres
DB_PASSWORD=password

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_key_here_minimum_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_key_here_minimum_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Microsoft SSO (Entra ID) ─────────────────────────────────────────────────
# Public identifiers, not secrets — safe to also ship in the frontend's own
# build config. Leave both unset to run with Microsoft SSO disabled; POST
# /auth/microsoft returns 503 MICROSOFT_SSO_NOT_CONFIGURED until both are
# set. Does not affect email/password login either way.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=

# ─── File Upload ──────────────────────────────────────────────────────────────
UPLOAD_PATH=src/uploads
MAX_FILE_SIZE=10485760

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=logs

# ─── Multi-Tenancy ────────────────────────────────────────────────────────────
# Defaults to true (log-only, never blocks) when unset. Set to "false" to
# flip resolveCompany() from shadow mode to strict enforcement (401 on a
# company mismatch) once the frontend's X-Company-Id header rollout is
# confirmed via the mismatch-warning logs.
COMPANY_SCOPE_SHADOW_MODE=true

# ─── SSL / HTTPS ──────────────────────────────────────────────────────────────
# Set SSL_ENABLED=true to have Node terminate HTTPS directly (instead of
# relying on a reverse proxy/IIS to terminate SSL in front of it).
# SSL_KEY_PATH / SSL_CERT_PATH are required when enabled; SSL_CA_PATH is only
# needed if your CA requires an intermediate/chain bundle. Paths are resolved
# relative to the project root.
SSL_ENABLED=false
SSL_KEY_PATH=./certs/server.key
SSL_CERT_PATH=./certs/server.crt
SSL_CA_PATH=
HTTPS_PORT=5443
# Set to false if Node terminates SSL directly with no reverse proxy in front
# (leave at 1, the default, when running behind IIS/another proxy).
TRUST_PROXY=1
